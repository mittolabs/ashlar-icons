{
  "name": "@mittolabs/ashlar-icons-core",
  "version": "0.2.0",
  "description": "The ashlaricons drawings as data: 6,553 icons in ten styles, for any framework's icon component.",
  "license": "ISC",
  "homepage": "https://icons.ashlar.ke",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mittolabs/ashlar-icons.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/mittolabs/ashlar-icons/issues",
  "keywords": [
    "icons",
    "svg",
    "ashlaricons"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./index.d.ts",
